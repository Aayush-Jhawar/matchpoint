# Optional. Without a key, invoices are read by the rules parser (+ tesseract OCR for scans).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Pause between stages so the run view is watchable. 0 for real use.
STAGE_DELAY_MS=450

# Windows only, if tesseract isn't on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
